# Populated by `azd provision` / `azd env set`. Do not commit real values.
#
# Set by azd after provision:
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment names (match the `name:` fields in foundry.deployments):
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1

# Secrets that connection credentials reference via ${VAR}:
GITHUB_MCP_TOKEN=
TAVILY_API_KEY=

# Routine input bindings:
TICKET_SOURCE_URL=
